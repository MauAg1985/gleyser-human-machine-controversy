{"publish":{"publish_pages_app":true,"publish_static_site":false,"publish_sha":"","publish_iso_date":"","include_slug_in_base":true},"users":[{"login_name":"MauAg1985","avatar_url":"https://avatars.githubusercontent.com/u/143436034?v=4","admin":true}],"project":{"github_org":"MauAg1985","is_private":false,"title":"Gleyzer: Latin American Left Imaginaries and Human-Machine Controversy","description":"This project examines the political imaginaries of the Latin American Left of the 1960s and 1970s through a close listening of the documentaries of Argentine filmmaker Raymundo Gleyzer. Using close listening alongside AI-assisted annotation, I engaged in an iterative process of interpretation with a large language model, in which the machine’s annotations became objects of discussion, revision, contestation, and reinscription. These exchanges frequently revealed tensions between the political and historical meanings embedded in Gleyzer’s films and the moral, cultural, and normative assumptions informing the model’s contemporary interpretations.","language":"en","slug":"gleyser-human-machine-controversy","creator":"MauAg1985","authors":"","media_player":"avannotate","auto_populate_home_page":true,"additional_users":[{"login_name":"celeste-camacho","avatar_url":"https://avatars.githubusercontent.com/u/156730112?v=4","admin":false}],"tags":{"tagGroups":[{"category":"Mediation, Authorship & Journalistic Form","color":"#ADFFD9"},{"category":"Internationalism, Cuba & Cold War","color":"#ADFEFF"},{"category":"Visual Rhetoric & Filmic Techniques","color":"#99E6FF"},{"category":"Affect, Emotion & Legitimacy","color":"#88C9F2"},{"category":"Revolutionary Leadership & Political Iconography","color":"#99AFF2"},{"category":"Rural–Urban Transformation & Development","color":"#B3B3E6"},{"category":"Children & Childhood as Political Imaginary","color":"#C195DB"},{"category":"Revolutionary Political Imaginaries","color":"#DA9ECF"},{"category":"Archivality, Evidence & Historical Time","co